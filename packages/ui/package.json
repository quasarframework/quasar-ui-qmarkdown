{
  "name": "@quasar/quasar-ui-qmarkdown",
  "version": "3.0.0-beta.0",
  "description": "Display inline markdown in your Quasar App",
  "keywords": [
    "markdown",
    "quasar",
    "quasarframework"
  ],
  "homepage": "https://github.com/quasarframework/quasar-ui-qmarkdown",
  "bugs": "https://github.com/quasarframework/quasar-ui-qmarkdown/issues",
  "license": "MIT",
  "author": "Jeff Galbraith <jeff@quasar.dev>",
  "contributors": [
    {
      "name": "Christian Behon",
      "email": "christian.behon@knusperleicht.at",
      "url": "https://knusperleicht.at"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasarframework/quasar-ui-qmarkdown.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hawkeye64"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.common.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.common.js"
    },
    "./index.min.css": {
      "default": "./dist/index.min.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./index.rtl.min.css": {
      "default": "./dist/index.rtl.min.css"
    },
    "./index.rtl.css": {
      "default": "./dist/index.rtl.css"
    },
    "./dist/api/QMarkdown.json": {
      "default": "./dist/api/QMarkdown.json"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint src build types",
    "build": "node build/index.js && node build/script.types.js",
    "build:js": "node build/script.javascript.js",
    "build:css": "node build/script.css.js",
    "build:api": "node build/build.api.js && node build/script.types.js",
    "typecheck": "tsc -p test-d/tsconfig.json --noEmit --pretty false",
    "test:types": "pnpm build && pnpm typecheck",
    "release": "pnpm publish --tag beta"
  },
  "dependencies": {
    "markdown-it": "^12.3.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-toc-and-anchor": "^4.2.0",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^12.2.3",
    "autoprefixer": "10.4.20",
    "chalk": "^2.4.2",
    "cssnano": "^5.1.7",
    "kolorist": "^1.8.0",
    "open": "^8.4.0",
    "postcss": "8.4.49",
    "punycode": "^2.3.1",
    "quasar": "^2.19.3",
    "quasar-json-api": "2.0.0-alpha.5",
    "rimraf": "^3.0.2",
    "rolldown": "^1.0.0",
    "rtlcss": "^3.5.0",
    "sass-embedded": "^1.83.0",
    "table": "^6.9.0",
    "typescript": "~5.9.3",
    "uglify-js": "^3.19.3",
    "vue": "^3.5.34",
    "zlib": "^1.0.5"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 10 Edge versions",
    "last 10 Safari versions",
    "last 10 Android versions",
    "last 10 ChromeAndroid versions",
    "last 10 FirefoxAndroid versions",
    "last 10 iOS versions"
  ],
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.1.0"
  },
  "vetur": {
    "tags": "dist/vetur/tags.json",
    "attributes": "dist/vetur/attributes.json"
  }
}
