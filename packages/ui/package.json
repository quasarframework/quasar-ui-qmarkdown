{
  "name": "@quasar/quasar-ui-qmarkdown",
  "version": "3.0.0-beta.0",
  "description": "Display inline markdown in your Quasar App",
  "keywords": [
    "markdown",
    "quasar",
    "quasarframework"
  ],
  "homepage": "https://github.com/quasarframework/quasar-ui-qmarkdown",
  "bugs": "https://github.com/quasarframework/quasar-ui-qmarkdown/issues",
  "license": "MIT",
  "author": "Jeff Galbraith <jeff@quasar.dev>",
  "contributors": [
    {
      "name": "Christian Behon",
      "email": "christian.behon@knusperleicht.at",
      "url": "https://knusperleicht.at"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasarframework/quasar-ui-qmarkdown.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hawkeye64"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./index.min.css": {
      "default": "./dist/index.min.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./index.rtl.min.css": {
      "default": "./dist/index.rtl.min.css"
    },
    "./index.rtl.css": {
      "default": "./dist/index.rtl.css"
    },
    "./dist/api/QMarkdown.json": {
      "default": "./dist/api/QMarkdown.json"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint src build types",
    "dev:umd": "pnpm build && tsx build/script.open-umd.ts",
    "build": "tsx build/index.ts",
    "build:js": "tsx build/script.javascript.ts",
    "build:css": "tsx build/script.css.ts",
    "build:api": "tsx build/build.api.ts && tsx build/script.types.ts",
    "build:app-ext": "tsx build/script.app-ext.ts",
    "build:types": "pnpm exec tsc --project tsconfig.json",
    "typecheck": "pnpm build:api && tsc -p test-d/tsconfig.json --noEmit --pretty false",
    "test:types": "pnpm build && pnpm build:types && pnpm typecheck",
    "release": "pnpm publish --tag beta"
  },
  "dependencies": {
    "markdown-it": "^14.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-toc-and-anchor": "^4.2.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/prismjs": "^1.26.6",
    "@types/rtlcss": "^3.5.4",
    "@types/uglify-js": "^3.17.5",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.1",
    "kolorist": "^1.8.0",
    "open": "^11.0.0",
    "postcss": "^8.5.15",
    "punycode": "^2.3.1",
    "quasar": "^2.19.3",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.2",
    "rtlcss": "^4.3.0",
    "sass-embedded": "^1.100.0",
    "table": "^6.9.0",
    "tsx": "^4.22.3",
    "typescript": "~5.9.3",
    "uglify-js": "^3.19.3",
    "vue": "^3.5.34"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 10 Edge versions",
    "last 10 Safari versions",
    "last 10 Android versions",
    "last 10 ChromeAndroid versions",
    "last 10 FirefoxAndroid versions",
    "last 10 iOS versions"
  ],
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.3.0"
  },
  "vetur": {
    "tags": "dist/vetur/tags.json",
    "attributes": "dist/vetur/attributes.json"
  }
}
