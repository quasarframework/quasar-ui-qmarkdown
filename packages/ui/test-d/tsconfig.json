{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "paths": {
      "@quasar/quasar-ui-qmarkdown": ["../dist/types/index.d.ts"],
      "@quasar/quasar-ui-qmarkdown/dist/api/QMarkdown.json": ["../dist/api/QMarkdown.json"]
    }
  },
  "include": ["*.ts"]
}
