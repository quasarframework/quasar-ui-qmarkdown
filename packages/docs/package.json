{
  "name": "docs",
  "version": "4.1.0",
  "private": true,
  "description": "QMarkdown Docs",
  "author": "Jeff Galbraith <galbraith64@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit --pretty false",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "pnpm run build:ssg",
    "postinstall": "quasar prepare --silent",
    "build:spa": "quasar build",
    "build:ssg": "quasar prepare && quasar build && qpress ssg",
    "build:ssg:renderer": "quasar prepare && quasar build -m ssr",
    "prerender:ssg": "qpress ssg",
    "preview:ssg": "quasar serve dist/spa --history",
    "check:qpress": "qpress check"
  },
  "dependencies": {
    "@markslides/markdown-it-mermaid": "^0.4.6",
    "@quasar/extras": "2.0.2",
    "katex": "^0.18.1",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "pinia": "^4.0.2",
    "quasar": "^2.24.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@md-plugins/quasar-app-extension-q-press": "2.0.2",
    "@md-plugins/search-ui": "2.0.2",
    "@md-plugins/vite-examples-plugin": "2.0.2",
    "@md-plugins/vite-md-plugin": "2.0.2",
    "@md-plugins/vite-search-plugin": "2.0.2",
    "@md-plugins/vite-ssg-plugin": "2.0.2",
    "@quasar/app-vite": "3.5.0",
    "@quasar/quasar-ui-qmarkdown": "workspace:*",
    "@types/node": "^26.1.2",
    "@vue/server-renderer": "^3.5.41",
    "autoprefixer": "^10.5.4",
    "hono": "^4.13.0",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "sass-embedded": "1.100.0",
    "shiki": "^4.4.2",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.5.0"
  },
  "productName": "QMarkdown Docs"
}
