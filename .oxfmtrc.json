{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    "packages/*/node_modules",
    "packages/*/.quasar",
    "packages/*/dist",
    "packages/docs/src/.q-press/**",
    "packages/docs/css",
    "packages/docs/fonts",
    "packages/docs/js",
    "packages/docs/public",
    "packages/dev/public",
    "pnpm-lock.yaml",
    "yarn.lock",
    "packages/dev/yarn.lock",
    "**/*.md"
  ]
}
